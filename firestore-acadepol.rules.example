// Aplicar somente no Firebase separado: acadepol-ae423.
// Firestore Database > Rules: copie o texto a seguir e publique.
// Somente o usuário autenticado pode acessar o próprio estado.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/acadepol/{documento} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && documento == 'state';
    }
  }
}
